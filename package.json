{
  "name": "mapa",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:bundle": "node scripts/check-public-bundle.mjs",
    "validation:cleanup": "node scripts/validation-run.mjs cleanup",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "test:rls": "node --test tests/integration/rls.test.mjs",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts",
    "test:integration": "npm run test:rls && npm run test:security && npm run test:invitations && npm run test:members && npm run test:e2e:auth",
    "db:types": "node scripts/generate-types.mjs",
    "test:invitations": "node --test tests/integration/invitations.test.mjs",
    "test:members": "node --test tests/integration/member-access.test.mjs",
    "test:a11y": "playwright test --config playwright.accessibility.config.ts",
    "test:performance": "npm run build && playwright test --config playwright.performance.config.ts && node scripts/benchmark-map-layout.mjs",
    "test:security": "node --test tests/integration/security.test.mjs",
    "test:deployment-config": "node --test tests/integration/deployment-config.test.mjs",
    "test:published": "node scripts/check-published.mjs && playwright test --config playwright.production.config.ts",
    "test:acceptance": "playwright test --config playwright.acceptance.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Mapa — SPA de mapas mentais para equipes",
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.4",
    "@xyflow/react": "12.12.0",
    "d3-hierarchy": "3.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0 <23",
    "npm": ">=10 <11"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "29.1.1",
    "supabase": "2.121.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
