# Configuração pública. Copie para .env.local e reinicie o Vite.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Somente servidor: nunca usar prefixo VITE_ nestes segredos.
OPENAI_API_KEY=
AI_MODEL=
AI_DAILY_TOKEN_BUDGET=50000

# Configuração das Edge Functions (no Supabase; não no bundle da Vercel).
MAPA_ALLOWED_ORIGINS=https://mapa.cnvt.com.br,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4174
MAPA_AUTH_CALLBACK_URLS=https://mapa.cnvt.com.br/auth/callback,http://127.0.0.1:5173/auth/callback,http://localhost:5173/auth/callback,http://127.0.0.1:4174/auth/callback
